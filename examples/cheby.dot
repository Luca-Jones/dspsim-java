#define M 1
#define L 16
#define H 1
#define GAMMA 6
#define GAMMASQ 36

digraph {
	//rankdir=LR
	in[type="impulse"];
	out[type="dataout", file="out.csv"];

	i1d[type="delay", shape=box];
	i1s[type="sum", label="+"];
	i2d[type="delay", shape=box];
	i2s[type="sum", label="+"];
	i3d[type="delay", shape=box];
	i3s[type="sum", label="+"];
	i4d[type="delay", shape=box];
	i4s[type="sum", label="+"];
	i5d[type="delay", shape=box];
	i5s[type="sum", label="+"];
	i6d[type="delay", shape=box];
	i6s[type="sum", label="+"];
	i7d[type="delay", shape=box];
	i7s[type="sum", label="+"];

	decim[type="decimator", ratio=M, label="↓"];

	c1d[type="delay", delay=L, shape=box];
	c1g[type="gain", value=-1, label="-1"];
	c1s[type="sum", label="+"];
	c2d[type="delay", delay=L, shape=box];
	c2g[type="gain", value=-1, label="-1"];
	c2s[type="sum", label="+"];
	c3d[type="delay", delay=L, shape=box];
	c3g[type="gain", value=-1, label="-1"];
	c3s[type="sum", label="+"];
	c4d[type="delay", delay=L, shape=box];
	c4g[type="gain", value=-1, label="-1"];
	c4s[type="sum", label="+"];
	c5d[type="delay", delay=L, shape=box];
	c5g[type="gain", value=-1, label="-1"];
	c5s[type="sum", label="+"];
	c6d[type="delay", delay=L, shape=box];
	c6g[type="gain", value=-1, label="-1"];
	c6s[type="sum", label="+"];
	c7d[type="delay", delay=L, shape=box];
	c7g[type="gain", value=-1, label="-1"];
	c7s[type="sum", label="+"];

	hold[type="hold", ratio=H];

	gam0[type="gain", value=GAMMA, label=GAMMA];
	gam1[type="gain", value=GAMMASQ, label=GAMMASQ];
	sh1[type="lshift", value=3, label="8"];
	gam2[type="gain", value=GAMMASQ, label=GAMMASQ];
	sh2[type="lshift", value=1, label="2"];
	gam3[type="gain", value=GAMMASQ, label=GAMMASQ];
	sh3[type="lshift", value=2, label="4"];

	b1d1[type="delay", shape=box];
	b1decim[type="decimator", ratio=M, label="↓"];
	b1d2[type="delay", delay=L, shape=box];
	b1g[type="gain", value=-7, label="-7"];
	b2d1[type="delay", shape=box];
	b2decim[type="decimator", ratio=M, label="↓"];
	b2d2[type="delay", delay=L, shape=box];
	b2g[type="gain", value=7, label="7"];
	b3d1[type="delay", shape=box];
	b3decim[type="decimator", ratio=M, label="↓"];
	b3d2[type="delay", delay=L, shape=box];
	b3g[type="gain", value=7, label="7"];

	i1d -> b1d1;
	b1d1 -> b1decim;
	b1decim -> b1d2;
	b1d2 -> b1g;
	b1g -> c7s;
	i3d -> b2d1;
	b2d1 -> b2decim;
	b2decim -> b2d2;
	b2d2 -> b2g;
	b2g -> c5s;
	i5d -> b3d1;
	b3d1 -> b3decim;
	b3decim -> b3d2;
	b3d2 -> b3g;
	b3g -> c3s;

	c2s -> gam3;
	gam3 -> sh3;
	sh3 -> c3s;
	sh3-> c3d;
	c4s -> gam2;
	gam2 -> sh2;
	sh2 -> c5s;
	sh2 -> c5d;
	c6s -> gam1;
	gam1 -> sh1;
	sh1 -> c7s;
	sh1 -> c7d;
	c7s -> gam0;
	gam0 -> hold;

	in -> i1s;
	i1s -> i1d;
	i1d -> i1s;
	i1d -> i2s;
	i2s -> i2d;
	i2d -> i2s;
	i2d -> i3s;
	i3s -> i3d;
	i3d -> i3s;
	i3d -> i4s;
	i4s -> i4d;
	i4d -> i4s;
	i4d -> i5s;
	i5s -> i5d;
	i5d -> i5s;
	i5d -> i6s;
	i6s -> i6d;
	i6d -> i6s;
	i6d -> i7s;
	i7s -> i7d;
	i7d -> i7s;
	i7d -> decim;
	decim -> c1s;
	decim -> c1d;
	c1d -> c1g;
	c1g -> c1s;
	c1s -> c2s;
	c1s -> c2d;
	c2d -> c2g;
	c2g -> c2s;
	c3d -> c3g;
	c3g -> c3s;
	c3s -> c4d;
	c3s -> c4s;
	c4d -> c4g;
	c4g -> c4s;
	c5d -> c5g;
	c5g -> c5s;
	c5s -> c6s;
	c5s -> c6d;
	c6d -> c6g;
	c6g -> c6s;
	c7d -> c7g;
	c7g -> c7s;

	hold -> out;

}
